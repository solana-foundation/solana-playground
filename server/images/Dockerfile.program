ARG USER=solpg
ARG BIN="build-program"

FROM ubuntu:24.04@sha256:80dd3c3b9c6cecb9f1667e9290b3bc61b78c2678c02cbdae5f0fea92cc6734ab AS base

# Install build deps
ARG DEBIAN_FRONTEND="noninteractive"
RUN apt-get update -qq && apt-get upgrade -qq && apt-get install -qq \
    build-essential bzip2 curl pkg-config libssl-dev libudev-dev

# Create a non-root user
ARG USER
RUN useradd -m -u 1001 -s /bin/bash ${USER}
USER ${USER}
ENV HOME="/home/${USER}"
WORKDIR ${HOME}

# Install Rust: rustup-init at a pinned version, checked against its SHA-256
# (rustup publishes rustup-init.sha256 next to the binary), as server/Dockerfile
ARG RUSTUP_VERSION="1.29.3"
ARG RUSTUP_SHA256="b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55"
RUN test "$(uname -m)" = x86_64 || { echo "this image is x86_64 only, got $(uname -m)" >&2; exit 1; }
RUN curl --proto '=https' --tlsv1.2 -sSfLo /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y \
    && rm /tmp/rustup-init
ENV PATH="${HOME}/.cargo/bin:${PATH}"

FROM base AS binary

# Cache toolchain
COPY rust-toolchain.toml .
RUN cargo --version

# Cache deps
COPY Cargo.* .
RUN mkdir src
RUN echo "fn main() {}" > src/main.rs
RUN cargo build --release

# Actual build
ARG BIN
COPY src src
RUN cargo build --release --bin ${BIN} --features unstable

FROM base AS solana

# Install Solana, in the layout of Agave's installer, from the tarball that
# installer fetches, checked against the SHA-256 pinned here for each version a
# template uses (`solana_version` in src/templates). A version missing here
# fails the build: add its checksum with the template.
ARG SOLANA_VERSION
RUN case "${SOLANA_VERSION}" in \
      1.17.25) sum="8c33eca52ed79b009050c9788db6d910ac84c1b11feae77110cabc7f7d5ed5a3" ;; \
      3.1.10) sum="a7205ff29bcf0f7199740225ecae2b85a28ea9668892d5ec21bd9749882984a1" ;; \
      *) echo "no pinned checksum for Solana ${SOLANA_VERSION}" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 -sSfLo /tmp/solana-release.tar.bz2 \
      "https://release.anza.xyz/v${SOLANA_VERSION}/solana-release-x86_64-unknown-linux-gnu.tar.bz2" \
    && echo "${sum}  /tmp/solana-release.tar.bz2" | sha256sum -c - \
    && mkdir -p "${HOME}/.local/share/solana/install/releases/${SOLANA_VERSION}" \
    && tar -xjf /tmp/solana-release.tar.bz2 -C "${HOME}/.local/share/solana/install/releases/${SOLANA_VERSION}" \
    && ln -s "${HOME}/.local/share/solana/install/releases/${SOLANA_VERSION}/solana-release" \
      "${HOME}/.local/share/solana/install/active_release" \
    && rm /tmp/solana-release.tar.bz2
ENV PATH="${HOME}/.local/share/solana/install/active_release/bin:${PATH}"

FROM solana AS final

# Not checked yet, unlike server/Dockerfile: the Anchor CLI `avm install`
# builds, and the platform tools and Criterion the Solana SDK fetches on the
# initial build below. This image is built only under the `unstable` feature.
# Run the installation command
ARG INSTALLATION_COMMAND
RUN sh -c "${INSTALLATION_COMMAND}"

# Switch Rust version
ARG RUST_VERSION
RUN rustup default ${RUST_VERSION}

# Copy the contents of the template directory
ARG USER
ARG TEMPLATE
COPY --chown=${USER}:${USER} templates/${TEMPLATE}/ .

# Build the default program to cache
ARG INITIAL_BUILD_COMMAND
RUN sh -c "${INITIAL_BUILD_COMMAND}"

# Remove the binary and IDL directories for clean start
ARG BINARY_PATH
ARG IDL_PATH
RUN rm -rf ${BINARY_PATH} ${IDL_PATH}

# Copy the built binary
ARG BIN
COPY --from=binary ${HOME}/target/release/${BIN} /usr/local/bin/
