#!/usr/bin/env sh
# Opt-in pre-commit hook: `git config core.hooksPath .githooks` once per clone.
# Prints the staged files' lint warnings and never blocks: pre-push's `check` is the gate.
root=$(git rev-parse --show-toplevel)
git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 "$root/client-v2/scripts/lint-changed.sh"
exit 0
