  "items": [
    {
      "name": "playground-tokens",
      "type": "registry:item",
      "title": "Playground tokens",
      "description": "Playground's tokens and their Tailwind theme: shadcn's semantic colours, the surface ramp, status, syntax, type, radius, layout, elevation, motion and the product utilities (frosted, gradient-stroke, brand-action). Import both files after tailwindcss.",
      "dependencies": [
        "tw-animate-css"
      ],
      "files": [
        {
          "path": "src/styles/tokens.css",
          "type": "registry:file",
          "target": "src/app/styles/playground-tokens.css"
        },
        {
          "path": "src/styles/theme.css",
          "type": "registry:file",
          "target": "src/app/styles/playground-theme.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn",
      "description": "Joins and merges class names, with the theme type scale (text-control, font-act and the rest) known to the merge, so a later text colour or font family does not drop them.",
