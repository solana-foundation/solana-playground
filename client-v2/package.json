  "scripts": {
    "setup": "yarn build-wasm && yarn install && yarn generate",
    "start": "yarn generate && craco start",
    "dev": "yarn generate-fast && craco start",
    "dev-cra": "BROWSER=none craco start",
    "dev-vercel": "yarn generate-fast && npx vercel dev --cwd .. --listen ${VERCEL_DEV_PORT:-3000}",
    "build": "bash ../wasm/build.sh && yarn install --frozen-lockfile --check-files && yarn build:bundle",
    "build:bundle": "yarn lint:layers && yarn generate && GENERATE_SOURCEMAP=false craco build && node scripts/upload-sourcemaps.mjs",
    "build-fast": "yarn lint:layers && yarn generate-fast && GENERATE_SOURCEMAP=false craco build",
    "build-wasm": "build=\"../wasm/build.sh\" && chmod +x $build && $build --update",
    "format": "prettier --write src/ api/",
    "check-format": "prettier --check src/ api/",
    "format-md": "markdownlint-cli2 --fix",
    "check-md": "markdownlint-cli2",
    "check-colors": "node scripts/check-colors.mjs",
    "ds-add": "node scripts/ds-add.mjs",
    "lint": "eslint --ext .ts,.tsx,.mjs,.mts src api e2e",
    "lint:layers": "eslint --quiet --ext .ts,.tsx,.mjs,.mts src/app src/widgets src/features src/entities src/shared api",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "spec:coverage": "node scripts/spec-coverage.mjs",
    "check": "yarn test-types && yarn check-format && yarn check-md && yarn lint && yarn check-colors && yarn spec:validate && yarn spec:coverage && yarn test-unit && yarn test-api",
    "generate": "node scripts/update-static.mjs && yarn generate-crates && yarn generate-default-crates && yarn generate-exports && yarn generate-packages && yarn generate-tutorials && yarn sync-assistant-context",
    "generate-fast": "node scripts/update-static.mjs && yarn generate-exports && yarn generate-packages && yarn generate-tutorials && yarn sync-assistant-context",
    "generate-crates": "node scripts/generate-crates.mjs",
    "generate-default-crates": "node scripts/generate-default-crates.mjs",
    "generate-exports": "node scripts/generate-exports.mjs",
    "generate-packages": "node scripts/generate-packages.mjs",
    "generate-tutorials": "node scripts/generate-tutorials.mjs",
    "sync-assistant-context": "node scripts/sync-assistant-context.mjs",
    "sync-readme": "node scripts/sync-readme.mjs",
    "test": "yarn test-types && yarn test-unit && yarn build:bundle",
    "test-types": "tsc --noEmit",
    "test-unit": "vitest run",
    "test-api": "node --test --env-file-if-exists=.env \"*.test.mjs\" \"api/**/*.test.mjs\" \"scripts/*.test.mjs\" \"src/features/**/model/**/*.test.mjs\" \"src/entities/**/model/**/*.test.mjs\" \"src/shared/**/*.test.mjs\"",
    "db-migrate": "dbmate --no-dump-schema up",
    "db-rollback": "dbmate --no-dump-schema down",
    "db-status": "dbmate status",
    "db-new": "dbmate new",
    "test-e2e": "playwright test",
    "test-build": "node --test \"scripts/*.build-test.mjs\"",
    "db-dump": "./scripts/db-dump.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "./eslint-layers.js"
    ],
    "overrides": [
      {
        "files": [
          "src/**",
          "e2e/**"
        ],
        "rules": {
          "no-restricted-syntax": [
            "error",
            {
              "selector": "MemberExpression[property.name='randomUUID']",
              "message": "Mint ids with uuid() from src/shared/lib/ids; crypto.randomUUID exists only in secure contexts."
            },
            {
              "selector": "VariableDeclarator > ObjectPattern > Property[key.name='randomUUID']",
              "message": "Mint ids with uuid() from src/shared/lib/ids; crypto.randomUUID exists only in secure contexts."
            },
            {
              "selector": "CallExpression[callee.property.name=/^(catch|then)$/] > Identifier.arguments[name='reportButtonFailure']",
              "message": "reportButtonFailure takes what did not happen first: .catch(reportButtonFailure(\"<action>\")). Passed bare, it returns a handler nobody calls and the failure is swallowed."
            }
          ]
        }
      },
      {
        "files": [
          "e2e/**"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                {
                  "name": "uuid",
                  "message": "Import uuid() / isUuid() from src/shared/lib/ids; it is the one module that talks to the library."
                }
              ],
              "patterns": [
                {
                  "group": [
                    "uuid/*"
                  ],
                  "message": "Import uuid() / isUuid() from src/shared/lib/ids; it is the one module that talks to the library."
                }
              ]
            }
          ],
          "no-restricted-syntax": [
            "error",
            {
              "selector": "MemberExpression[property.name='randomUUID']",
              "message": "Mint ids with uuid() from src/shared/lib/ids; crypto.randomUUID exists only in secure contexts."
            },
            {
              "selector": "VariableDeclarator > ObjectPattern > Property[key.name='randomUUID']",
              "message": "Mint ids with uuid() from src/shared/lib/ids; crypto.randomUUID exists only in secure contexts."
            },
            {
              "selector": "Literal[regex.pattern=/\\{8\\}\\\\?-/]",
              "message": "Check an id with isUuid() from src/shared/lib/ids instead of a copied UUID regex."
            }
          ]
        }
      },
      {
        "files": [
          "src/{app,features,shared,entities,widgets}/**"
        ],
        "rules": {
          "no-empty": [
            "error",
            {
              "allowEmptyCatch": false
            }
          ],
          "no-nested-ternary": "error",
          "no-restricted-imports": [
            "error",
            {
              "paths": [
                {
                  "name": "uuid",
                  "message": "Import uuid() / isUuid() from src/shared/lib/ids; it is the one module that talks to the library."
                },
                {
                  "name": "cn",
                  "message": "Import cn from src/shared/lib/utils; it knows the theme type scale, the bare package drops text-control, font-act and the rest."
                }
              ],
              "patterns": [
                {
                  "group": [
                    "uuid/*"
                  ],
                  "message": "Import uuid() / isUuid() from src/shared/lib/ids; it is the one module that talks to the library."
                }
              ]
            }
          ],
          "no-restricted-syntax": [
            "error",
            {
              "selector": "MemberExpression[property.name='randomUUID']",
              "message": "Mint ids with uuid() from src/shared/lib/ids; crypto.randomUUID exists only in secure contexts."
            },
            {
              "selector": "VariableDeclarator > ObjectPattern > Property[key.name='randomUUID']",
              "message": "Mint ids with uuid() from src/shared/lib/ids; crypto.randomUUID exists only in secure contexts."
            },
            {
              "selector": "Literal[regex.pattern=/\\{8\\}\\\\?-/]",
              "message": "Check an id with isUuid() from src/shared/lib/ids instead of a copied UUID regex."
            },
            {
              "selector": "CallExpression[callee.property.name=/^(catch|then)$/] > Identifier.arguments[name='reportButtonFailure']",
              "message": "reportButtonFailure takes what did not happen first: .catch(reportButtonFailure(\"<action>\")). Passed bare, it returns a handler nobody calls and the failure is swallowed."
            }
          ]
        }
      },
      {
        "files": [
          "src/shared/lib/ids.ts",
          "src/shared/lib/ids.test.mts"
        ],
        "rules": {
          "no-restricted-imports": "off",
          "no-restricted-syntax": "off"
        }
      },
      {
        "files": [
          "src/shared/lib/utils.ts"
        ],
        "rules": {
          "no-restricted-imports": "off"
        }
      },
      {
        "files": [
          "**/*.test.ts",
          "**/*.test.tsx",
          "**/*.test.mts",
          "**/*.test.mjs",
          "e2e/**"
        ],
        "rules": {
          "import/first": "off"
        }
      },
      {
        "files": [
          "**/*.mts"
        ],
        "parser": "@typescript-eslint/parser",
        "plugins": [
          "@typescript-eslint"
        ],
        "rules": {
          "default-case": "off",
          "no-dupe-class-members": "off",
          "no-undef": "off",
          "no-array-constructor": "off",
          "no-redeclare": "off",
          "@typescript-eslint/no-redeclare": "warn",
          "no-use-before-define": "off",
          "@typescript-eslint/no-use-before-define": [
            "warn",
            {
              "functions": false,
              "classes": false,
              "variables": false,
              "typedefs": false
            }
          ],
          "no-unused-expressions": "off",
          "@typescript-eslint/no-unused-expressions": [
            "error",
            {
              "allowShortCircuit": true,
              "allowTernary": true,
              "allowTaggedTemplates": true
            }
          ],
          "no-unused-vars": "off",
          "@typescript-eslint/no-unused-vars": [
            "warn",
            {
              "args": "none",
              "ignoreRestSiblings": true
            }
          ]
        }
      }
    ]
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "opera >= 97",
    "safari >= 16.4"
  ]
}
