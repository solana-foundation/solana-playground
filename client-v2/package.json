  "scripts": {
    "setup": "bash scripts/setup-wasm.sh && yarn generate",
    "setup:with-stubs": "USE_WASM_STUBS=true yarn setup",
    "start": "node scripts/wasm-stubs.mjs guard start && yarn generate && craco start",
    "dev": "node scripts/wasm-stubs.mjs guard dev && yarn generate-fast && yarn generate-dev-crates && craco start",
    "dev:with-stubs": "USE_WASM_STUBS=true yarn dev",
    "dev-cra": "node scripts/wasm-stubs.mjs guard dev-cra && BROWSER=none craco start",
    "dev-vercel": "yarn generate-fast && yarn generate-dev-crates && npx vercel dev --cwd .. --listen ${VERCEL_DEV_PORT:-3000}",
    "build": "bash scripts/setup-wasm.sh && yarn build:bundle",
    "build:bundle": "node scripts/server-url-gate.mjs && yarn lint:layers && yarn generate && GENERATE_SOURCEMAP=false craco build && node scripts/public-env.mjs check-build build && node scripts/upload-sourcemaps.mjs",
    "build-fast": "node scripts/wasm-stubs.mjs guard build-fast && yarn lint:layers && yarn generate-fast && GENERATE_SOURCEMAP=false craco build",
    "build-wasm": "bash ../wasm/build.sh",
    "format": "prettier --write src/ api/ e2e/ scripts/ eslint-plugin-layers/",
    "check-format": "prettier --check src/ api/ e2e/ scripts/ eslint-plugin-layers/",
    "format-md": "markdownlint-cli2 --fix",
    "check-md": "markdownlint-cli2",
    "check-colors": "node scripts/check-colors.mjs",
    "ds-add": "node scripts/ds-add.mjs",
    "lint": "eslint --max-warnings 2216 src api e2e scripts eslint-plugin-layers",
    "lint:layers": "eslint --quiet src/app src/widgets src/features src/entities src/shared api",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "spec:coverage": "node scripts/spec-coverage.mjs",
    "tutorial:check": "tsx scripts/tutorial-check.ts",
    "tutorial:idl": "node scripts/tutorial-idl/generate.mjs",
    "tutorial:skill": "node scripts/tutorial-skill.mjs",
    "check": "yarn test-types && yarn check-format && yarn check-md && yarn lint && yarn check-colors && yarn tutorial:check && yarn spec:validate && yarn spec:coverage && yarn test-unit && yarn test-api",
    "generate": "node scripts/update-static.mjs && yarn generate-crates && yarn generate-default-crates && yarn generate-exports && yarn generate-packages && yarn generate-tutorials && yarn sync-assistant-context",
    "generate-fast": "node scripts/update-static.mjs && yarn generate-exports && yarn generate-packages && yarn generate-tutorials && yarn sync-assistant-context",
    "generate-crates": "node scripts/generate-crates.mjs",
    "generate-default-crates": "node scripts/generate-default-crates.mjs",
    "generate-dev-crates": "node scripts/generate-dev-crates.mjs",
    "generate-exports": "node scripts/generate-exports.mjs",
    "generate-packages": "node scripts/generate-packages.mjs",
    "generate-tutorials": "node scripts/generate-tutorials.mjs",
    "sync-assistant-context": "node scripts/sync-assistant-context.mjs",
    "sync-readme": "node scripts/sync-readme.mjs",
    "test": "yarn test-types && yarn test-unit && yarn build:bundle",
    "test-types": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "test-unit": "vitest run",
    "test-api": "node --test --env-file-if-exists=.env \"*.test.mjs\" \"api/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "db-migrate": "dbmate --no-dump-schema up",
    "db-rollback": "dbmate --no-dump-schema down",
    "db-status": "dbmate status",
    "db-new": "dbmate new",
    "test-e2e": "node scripts/wasm-stubs.mjs guard test-e2e && playwright test",
    "test-e2e:with-stubs": "USE_WASM_STUBS=true yarn test-e2e --grep-invert @real-wasm",
    "test-build": "node --test \"scripts/*.build-test.mjs\"",
    "bundle:info": "node scripts/wasm-stubs.mjs check-build build && node scripts/bundle-info.mjs",
    "db-dump": "./scripts/db-dump.sh"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "opera >= 97",
    "safari >= 16.4"
  ]
}
