# Copy to .env for local development (dbmate, `yarn test-api` and CRA all read
# it) and set the same names in the Vercel dashboard.
#
# Load into the current shell with `set -a; . ./.env; set +a`.
#
# Put links on their own line: dotenv@10 reads `KEY=value # note` as part of
# the value.
#
# Only REACT_APP_* names reach the browser (src/shared/config/client-env.ts);
# api/*.mjs reads the rest on the server (src/shared/config/server-env.mjs).

# --- GitHub OAuth App, read by api/auth.mjs (Better Auth) --------------------
# The app's Client ID; add one callback URL per origin,
# `<origin>/api/auth/callback/github`, and keep wildcard matching and Device
# Flow off.
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
# The app's client secret, from "Generate a new client secret".
GITHUB_CLIENT_SECRET=

# --- Build server ------------------------------------------------------------
# The build server; unset, the Solana Foundation's, and http://localhost:8080
# for your own (compose's v2 profiles set it themselves). A browser profile
# that picked another build server in Settings keeps it over this value.
# https://github.com/solana-playground/solana-playground/tree/master/server
REACT_APP_SERVER_URL=
# Exactly "true" sends builds and deploys to the server's /unstable routes,
# which only a server built with --features unstable has. A browser profile
# that has stored the unstable setting keeps it over this value.
REACT_APP_SERVER_UNSTABLE=

# --- Sources catalogue, read by api/mcp.mjs and api/skills.mjs ---------------
# Optional JSON array that replaces SOURCES_CATALOGUE in
# src/shared/config/sources.mjs; docs/deploy-client-vercel.md ("Sources
# catalogue") has the format and a starting point.
SOURCES=
# Optional bypass secret for an Explorer deployment behind Vercel bot protection.
# https://vercel.com/docs/deployment-protection/methods-to-bypass-deployment-protection
MCP_EXPLORER_BYPASS=
# Optional; unset, https://explorer.solana.com/mcp.
MCP_EXPLORER_URL=
# Optional; needed only when the Explorer deployment checks MCP_ACCESS_KEYS.
MCP_EXPLORER_TOKEN=

# --- Observability, read by src/shared/config/client-env.ts ------------------
# The Sentry DSN; Sentry runs only in Vercel production, or in preview with
# SENTRY_PREVIEW_ENABLED (scripts/sentry-gate.mjs).
REACT_APP_SENTRY_DSN=
# Exactly "true" makes preview deployments report to Sentry too.
SENTRY_PREVIEW_ENABLED=
# The share of API requests to trace, 0 to 1; unset, all of them.
SENTRY_TRACES_SAMPLE_RATE=
# Exactly "true" uploads source maps from preview builds too
# (scripts/sourcemap-gate.mjs).
SOURCEMAPS_PREVIEW_ENABLED=
# Uploads source maps; set it in Vercel only, since the upload script
# (scripts/upload-sourcemaps.mjs) loads no .env file. A production build fails
# without it.
SENTRY_AUTH_TOKEN=
# The Google Analytics 4 measurement id (G-...); unset, the page has no tag.
REACT_APP_GA_MEASUREMENT_ID=
# panic, error, warn, info or debug; unset, warn in production and debug elsewhere.
REACT_APP_LOG_LEVEL=
# vercel.json's buildCommand fills these two from VERCEL_GIT_COMMIT_SHA and
# VERCEL_ENV; leave them unset locally.
REACT_APP_VERCEL_GIT_COMMIT_SHA=
REACT_APP_VERCEL_ENV=

# --- Platform RPC endpoints --------------------------------------------------
# Optional; Settings › Network offers Mainnet, Devnet and Testnet on these URLs,
# else on the public endpoints, and the devnet one is a new profile's default.
# They ship in the browser bundle, so use a same-origin proxy or a URL locked to
# your origin, never an unrestricted key.
# https://solana.com/rpc
REACT_APP_DEVNET_RPC_URL=
REACT_APP_MAINNET_RPC_URL=

# --- Read-buffer RPC endpoints -----------------------------------------------
# The RPC a deploy reads its program buffer through, because a platform RPC can
# return null for a new buffer; unset, the selected endpoint.
REACT_APP_DEVNET_READ_BUFFER_RPC_URL=https://api.devnet.solana.com
REACT_APP_TESTNET_READ_BUFFER_RPC_URL=https://api.testnet.solana.com
REACT_APP_MAINNET_READ_BUFFER_RPC_URL=https://api.mainnet.solana.com

# --- Deploy send caps --------------------------------------------------------
# Buffer writes per second during a deploy; set it just below the RPC plan's
# sendTransaction limit (Helius Developer: 5/s), since writes at the limit get
# refused.
# https://www.helius.dev/docs/billing/rate-limits
REACT_APP_DEVNET_SEND_TX_PER_SECOND=4
REACT_APP_TESTNET_SEND_TX_PER_SECOND=4
REACT_APP_MAINNET_SEND_TX_PER_SECOND=4

# --- Default assistant backend, read by api/agent.mjs -------------------------
# The old AGENT_* names are read only when the PG_AI_* name is not set at all.

# The upstream's bearer token; unset, the Default backend is off, and it needs
# sign-in configured, since only signed-in users spend it. A Vercel build fails
# without it, and a production build with it fails without sign-in or a valid
# AUTH_BASE_URL (scripts/check-agent-env.mjs).
PG_AI_API_KEY=
# A chat-completions base URL, no trailing slash; unset, Nous, whose model id
# differs, so change it with PG_AI_MODEL.
# https://platform.openai.com/docs/api-reference/chat
PG_AI_BASE_URL=https://ai-gateway.vercel.sh/v1
# The only model the assistant runs.
# https://ai-gateway.vercel.sh/v1/models
PG_AI_MODEL=zai/glm-5.3-flash
# Sent as `reasoning_effort`; keep it low, since the panel shows no reasoning
# and a long one looks stalled.
PG_AI_REASONING_EFFORT=low

# Spend limits: docs/deploy-client-vercel.md, "Default backend spend".
# Optional Gateway key for `newcomer` users; unset, they spend PG_AI_API_KEY.
PG_AI_NEWCOMER_API_KEY=
# Gateway providers allowed to serve a turn; delete the line, don't blank it,
# when PG_AI_BASE_URL is not the Gateway.
PG_AI_PROVIDERS=baseten,fireworks
# USD per million tokens at the Gateway's list price for zai/glm-5.3-flash
# (checked 2026-10-29); change them with the model.
PG_AI_PRICE_INPUT=0.15
PG_AI_PRICE_OUTPUT=0.5
# A larger request body gets a 413.
PG_AI_MAX_BODY_BYTES=524288
# Sent upstream as max_completion_tokens.
PG_AI_MAX_OUTPUT_TOKENS=8192
# Days until a GitHub account counts as `established`.
PG_AI_NEWCOMER_AGE_DAYS=30
# USD per user per UTC day, for each tier.
PG_AI_NEWCOMER_DAILY_CAP=0.1
PG_AI_ESTABLISHED_DAILY_CAP=0.5

# --- Conversation and project sync, read by api/sync.mjs ---------------------
# `url` (DATABASE_URL) or `cloud-sql` (the CLOUD_SQL_* and GCP_* variables);
# unset means `url`, and any other value turns sync off.
DB_PROVIDER=
# A pooled Postgres connection string; locally
# `postgres://solpg:solpg@localhost:5432/solpg?sslmode=disable`, since the
# compose container has no TLS.
# https://www.postgresql.org/docs/16/libpq-connect.html#LIBPQ-CONNSTRING
DATABASE_URL=
# `cloud-sql` only, all seven required, signed in through Vercel OIDC with no
# password; setup in docs/cloud-sql.md.
CLOUD_SQL_INSTANCE=
CLOUD_SQL_DATABASE=
CLOUD_SQL_USER=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
# Exactly "true" turns sync on; keep it off until `/api/sync` reports
# `{"db":"ok"}`.
SYNC_ENABLED=

# --- Neon preview databases, read by Makefile.vercel -------------------------
# Not read by the app; docs/neon.md says where to get both.
NEON_API_KEY=
NEON_PROJECT_ID=

# --- Better Auth, read by api/auth.mjs ---------------------------------------
# Signs session cookies; generate with `openssl rand -base64 32`, and changing
# it signs everyone out.
AUTH_SECRET=
# The deployment's origin with no trailing slash, which builds the OAuth
# callback; open the app on this origin, since the API refuses sync writes
# from any other. Locally, and by default under compose, http://127.0.0.1:3000.
AUTH_BASE_URL=
# Previews only: the host's origin, whose callback is on the GitHub app.
AUTH_OAUTH_PROXY_URL=
# Encrypts what the host sends a preview; the same value on the host and every
# preview, generated with `openssl rand -base64 32`.
AUTH_OAUTH_PROXY_SECRET=
