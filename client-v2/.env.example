# Copy to .env for local development and set the same names in Vercel.
# Load into a shell with `set -a; . ./.env; set +a`.
# Put links on their own line: dotenv@10 reads `KEY=value # note` as the value.
# Only REACT_APP_* reach the browser, and every one is public
# (docs/deploy-client-vercel.md, "Public variables").

# --- GitHub OAuth App, read by api/auth.mjs ----------------------------------
# Callback URL per origin: `<origin>/api/auth/callback/github`.
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Build server ------------------------------------------------------------
# The default build server; ask a maintainer for the production URL. A
# deployment with sign-in sets /api/build-server and PG_BUILD_SERVER_URL.
# https://github.com/solana-playground/solana-playground/tree/master/server
REACT_APP_SERVER_URL=
# Exactly "true" uses the server's /unstable routes.
REACT_APP_SERVER_UNSTABLE=

# --- Build server route, read by api/build-server.mjs -------------------------
# Where /api/build-server forwards builds; unset, it refuses every build.
PG_BUILD_SERVER_URL=
# Sent as x-api-key: this deployment's entry of the server's PG_API_KEYS.
PG_BUILD_SERVER_API_KEY=

# --- Sources catalogue, read by api/mcp.mjs and api/skills.mjs ---------------
# Optional JSON array replacing SOURCES_CATALOGUE (docs/deploy-client-vercel.md,
# "Sources catalogue").
SOURCES=
# Optional bypass secret for an Explorer behind Vercel bot protection.
MCP_EXPLORER_BYPASS=
# Optional; unset, https://explorer.solana.com/mcp.
MCP_EXPLORER_URL=
# Optional; needed when the Explorer checks MCP_ACCESS_KEYS.
MCP_EXPLORER_TOKEN=
# Optional bounds on api/mcp.mjs; defaults in its source.
MCP_TIMEOUT_MS=
MCP_MAX_REQUEST_BYTES=
MCP_MAX_RESPONSE_BYTES=

# --- Observability -----------------------------------------------------------
# Sentry runs in Vercel production, or in preview with SENTRY_PREVIEW_ENABLED.
REACT_APP_SENTRY_DSN=
SENTRY_PREVIEW_ENABLED=
# Share of API requests to trace, 0 to 1; unset, all.
SENTRY_TRACES_SAMPLE_RATE=
# Share of page loads to trace, 0 to 1; unset, all. Needs a redeploy.
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=
# Exactly "true" uploads source maps from previews too.
SOURCEMAPS_PREVIEW_ENABLED=
# Uploads source maps; Vercel only. A production build fails without it.
SENTRY_AUTH_TOKEN=
# GA4 measurement id (G-...); unset, no tag.
REACT_APP_GA_MEASUREMENT_ID=
# panic, error, warn, info or debug.
REACT_APP_LOG_LEVEL=
# Filled by vercel.json's buildCommand; leave unset locally.
REACT_APP_VERCEL_GIT_COMMIT_SHA=
REACT_APP_VERCEL_ENV=

# --- Platform RPC endpoints --------------------------------------------------
# Optional; unset, the public endpoints. They ship in the bundle, so never use
# an unrestricted key.
# https://solana.com/rpc
REACT_APP_DEVNET_RPC_URL=
REACT_APP_MAINNET_RPC_URL=
REACT_APP_TESTNET_RPC_URL=
# Comma-separated names above whose key is restricted to the production origin.
PUBLIC_ENV_RESTRICTED_KEYS=

# --- Native RPC endpoints (named READ_BUFFER) --------------------------------
# The cluster's own RPC, for airdrops and deploy buffer reads that a platform
# RPC can refuse.
REACT_APP_DEVNET_READ_BUFFER_RPC_URL=https://api.devnet.solana.com
REACT_APP_TESTNET_READ_BUFFER_RPC_URL=https://api.testnet.solana.com
REACT_APP_MAINNET_READ_BUFFER_RPC_URL=https://api.mainnet.solana.com

# --- Deploy send caps --------------------------------------------------------
# Buffer writes per second; keep it below the RPC plan's sendTransaction limit.
# https://www.helius.dev/docs/billing/rate-limits
# REACT_APP_DEVNET_SEND_TX_PER_SECOND=4
# REACT_APP_TESTNET_SEND_TX_PER_SECOND=4
# REACT_APP_MAINNET_SEND_TX_PER_SECOND=4

# --- Wallet key origin -------------------------------------------------------
# Unset, the wallet's keys stay in the app's IndexedDB. Production leaves both
# unset until the key host exists (HOO-2708).
# REACT_APP_WALLET_KEY_ORIGIN=
# REACT_APP_WALLET_APP_ORIGIN=

# --- Default assistant backend, read by api/agent.mjs -------------------------
# Unset, the Default backend is off; it needs sign-in configured.
PG_AI_API_KEY=
# A chat-completions base URL, no trailing slash.
# https://platform.openai.com/docs/api-reference/chat
PG_AI_BASE_URL=https://ai-gateway.vercel.sh/v1
# https://ai-gateway.vercel.sh/v1/models
PG_AI_MODEL=zai/glm-5.3-flash
# Keep it low: the panel shows no reasoning.
PG_AI_REASONING_EFFORT=low

# Spend limits: docs/deploy-client-vercel.md, "Default backend spend".
PG_AI_NEWCOMER_API_KEY=
# Delete the line when PG_AI_BASE_URL is not the Gateway.
PG_AI_PROVIDERS=baseten,fireworks
# USD per million tokens for PG_AI_MODEL; change them with the model.
PG_AI_PRICE_INPUT=0.15
PG_AI_PRICE_OUTPUT=0.5
PG_AI_MAX_BODY_BYTES=524288
PG_AI_MAX_OUTPUT_TOKENS=8192
PG_AI_NEWCOMER_AGE_DAYS=30
# USD per user per UTC day.
PG_AI_NEWCOMER_DAILY_CAP=0.1
PG_AI_ESTABLISHED_DAILY_CAP=0.5

# --- Conversation and project sync, read by api/sync.mjs ---------------------
# `url` (default) or `cloud-sql`; any other value turns sync off.
DB_PROVIDER=
# Locally `postgres://solpg:solpg@localhost:5432/solpg?sslmode=disable`.
DATABASE_URL=
# `cloud-sql` only, all required (docs/cloud-sql.md).
CLOUD_SQL_INSTANCE=
CLOUD_SQL_DATABASE=
CLOUD_SQL_USER=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
# Exactly "true" turns sync on, once `/api/sync` reports `{"db":"ok"}`.
SYNC_ENABLED=

# --- Neon preview databases, read by Makefile.vercel -------------------------
# docs/neon.md says where to get both.
NEON_API_KEY=
NEON_PROJECT_ID=

# --- Vercel deploy target, read by Makefile.vercel ---------------------------
# docs/deploy-client-vercel.md, "One-time setup".
VERCEL_DEPLOY_PROJECT_ID=
VERCEL_DEPLOY_TEAM=

# --- Sealed production cache, read by scripts/vercel-install.sh --------------
# `openssl rand -hex 32`; Vercel only, Production, Sensitive.
CACHE_SEAL_KEY=

# --- Retention job, read by api/retention.mjs --------------------------------
# Vercel Cron's bearer token; `openssl rand -base64 32`. Unset, the route
# answers 503.
CRON_SECRET=

# --- Better Auth, read by api/auth.mjs ---------------------------------------
# `openssl rand -base64 32`; changing it signs everyone out.
AUTH_SECRET=
# The origin the app is opened on, no trailing slash; locally
# http://127.0.0.1:3000.
AUTH_BASE_URL=
# Previews only: the host's origin and a secret shared with it.
AUTH_OAUTH_PROXY_URL=
AUTH_OAUTH_PROXY_SECRET=

# --- Share card and robots.txt, read by craco.config.js ----------------------
# Optional origin for the share card (resolveSiteUrl in scripts/brand-head.mjs).
SITE_URL=
# Set by Vercel; set it by hand only to reproduce a Vercel build.
# VERCEL_PROJECT_PRODUCTION_URL=
# Exactly "true" disallows crawlers, on a production build that is not the
# public site.
DISALLOW_ROBOTS=
