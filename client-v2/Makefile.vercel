# do we still need this?


# Local Vercel deploy targets. See client-v2/docs/deploy-client-vercel.md.
# Targets assume repo-root cwd (.vercel/ state at root); the built directory is
# forced to $(CLIENT_DIR) below, so the dashboard Root Directory only governs
# the Git-integration deploys.
# `vercel build` reads $(CLIENT_DIR)/vercel.json (installCommand, buildCommand) so install/build chain isn't duplicated here.
# `--archive=tgz` on deploy: the prebuilt output is ~16k files and the upload API
# rejects more than 15000, so the whole tree goes up as one tarball instead.

CLIENT_DIR := client-v2

# Targets verified against this CLI version; bump only after re-running them.
VERCEL_CLI := vercel@62.7.0

# Where a laptop preview's database lives: `url` (a Neon branch of the preview
# project, the default) or `cloud-sql` (a database on the preview Cloud SQL
# instance). The targets below call the same script names in either provider's
# directory, and each script takes the git branch, never a database name. See
# $(CLIENT_DIR)/docs/preview-databases.md.
DB_PROVIDER ?= url
DB_SCRIPTS = $(CLIENT_DIR)/scripts/db/$(DB_PROVIDER)
GIT_BRANCH = $$(git rev-parse --abbrev-ref HEAD)

define check_provider
	@case "$(DB_PROVIDER)" in url|cloud-sql) ;; *) \
		echo "DB_PROVIDER must be url or cloud-sql, not \"$(DB_PROVIDER)\"" >&2; exit 1;; esac
endef

# The cloud-sql scripts need the preview instance and the preview application's
# IAM database user, which live in Vercel's Preview environment (`make
# vercel-link-preview` pulls it). Read by name and passed to those scripts
# only, never exported to every recipe: production targets must not inherit
# preview values. The url scripts ignore both.
previewenv = $(shell sed -n 's/^$(1)=//p' .vercel/.env.preview.local 2>/dev/null | head -1 | tr -d '"'"'"'"')
PREVIEW_CLOUD_SQL = CLOUD_SQL_INSTANCE="$${CLOUD_SQL_INSTANCE:-$(call previewenv,CLOUD_SQL_INSTANCE)}" \
	CLOUD_SQL_USER="$${CLOUD_SQL_USER:-$(call previewenv,CLOUD_SQL_USER)}"

# Secrets live in $(CLIENT_DIR)/.env, which dbmate reads by itself. Make does not,
# so the Neon values are lifted out here and exported to every recipe. `?=` leaves
# an already-exported value alone; named keys are read rather than the file
# sourced, so a stray DATABASE_URL in there cannot redirect a migration.
# See $(CLIENT_DIR)/docs/neon.md.
dotenv = $(shell sed -n 's/^$(1)=//p' $(CLIENT_DIR)/.env 2>/dev/null | head -1 | tr -d '"'"'"'"')
NEON_API_KEY ?= $(call dotenv,NEON_API_KEY)
NEON_PROJECT_ID ?= $(call dotenv,NEON_PROJECT_ID)
export NEON_API_KEY NEON_PROJECT_ID

# `--token` is passed only when VERCEL_TOKEN is set; otherwise the CLI uses the
# login from `vercel login`, which a developer already has. A token is for CI.
# Locally it is worse than unnecessary: the only token narrow enough to be safe
# to keep in a shell is project-scoped, and the CLI calls `/v2/user` and
# `/v3/user/tokens/current` on startup, which project-scoped tokens deny -- so a
# required token forced an All Projects token, i.e. org-wide CLI access, to run
# one preview deploy. `$${VAR:+word}` expands to nothing when VAR is unset, and
# the token never reaches the echoed recipe because make prints the text, not
# the value.
VERCEL_TOKEN_ARG = $${VERCEL_TOKEN:+--token=$$VERCEL_TOKEN}

.PHONY: vercel-bootstrap vercel-auth vercel-link-preview vercel-link-production \
	deploy-client-to-vercel-preview deploy-client-to-vercel-production deploy-client-to-vercel-prod-fast \
	preview-db-branch migrate-preview-db migrate-production-db

# Both IDs come from the link file because an exported VERCEL_PROJECT_ID outranks
# it in the CLI's project resolution, leaving orgId unresolved.
VERCEL_IDS = export VERCEL_ORG_ID=$$(jq -r .orgId .vercel/project.json) && \
	export VERCEL_PROJECT_ID=$$(jq -r .projectId .vercel/project.json)

# Names the auth fix the CLI's "Could not retrieve Project Settings" hides; stdin is /dev/null so a missing login fails instead of prompting.
define vercel_auth
	@test -f .vercel/project.json || { echo "no .vercel/project.json: run 'make vercel-bootstrap'" >&2; exit 1; }
	@out=$$($(VERCEL_IDS) && npx $(VERCEL_CLI) whoami $(VERCEL_TOKEN_ARG) </dev/null 2>&1) || { \
		printf '%s\n' "$$out" >&2; \
		if [ -n "$${VERCEL_TOKEN:-}" ]; then \
			echo "VERCEL_TOKEN was rejected. A project-scoped token cannot drive the CLI: run 'unset VERCEL_TOKEN' to use your 'vercel login' session, or use an All Projects token." >&2; \
		else \
			echo "No working Vercel CLI login: run 'npx $(VERCEL_CLI) login' with an account in team $$(jq -r .orgId .vercel/project.json)." >&2; \
		fi; \
		exit 1; }; \
		echo "Vercel CLI user: $$(printf '%s\n' "$$out" | tail -1)"
endef

# $(1): Vercel environment to pull (preview | production).
define vercel_link
	$(call vercel_auth)
	$(VERCEL_IDS) && npx $(VERCEL_CLI) pull --yes --environment=$(1) $(VERCEL_TOKEN_ARG)
	@# pull overwrites the cached settings with the dashboard's Root Directory; force ours back.
	@jq --arg dir '$(CLIENT_DIR)' '.settings.rootDirectory = $$dir' \
		.vercel/project.json > .vercel/project.json.next
	@mv .vercel/project.json.next .vercel/project.json
	@echo "Root Directory pinned to $(CLIENT_DIR)"
endef

# Resolve orgId from Vercel API + write .vercel/project.json. Requires jq.
# The one target that still requires VERCEL_TOKEN: this calls the REST API
# directly and a raw request has no stored login to fall back on. A
# project-scoped token is enough here -- /v9/projects/<id> is project-level.
vercel-bootstrap: ## Link the local checkout to the dashboard project (run once; needs VERCEL_TOKEN, VERCEL_PROJECT_ID)
	@: $${VERCEL_TOKEN:?VERCEL_TOKEN is unset}
	@: $${VERCEL_PROJECT_ID:?VERCEL_PROJECT_ID is unset}
	@command -v jq >/dev/null 2>&1 || { echo "jq required — see https://jqlang.org/download/" >&2; exit 1; }
	@# `printf '%s'`, never `echo`: macOS /bin/sh is bash in sh mode with xpg_echo
	@# on, so its echo expands the \n inside the response's JSON strings into real
	@# newlines and hands jq invalid input. The project payload embeds commit
	@# messages, so one multi-line commit is enough to break bootstrap.
	@response=$$(curl -sH "Authorization: Bearer $${VERCEL_TOKEN}" "https://api.vercel.com/v9/projects/$${VERCEL_PROJECT_ID}"); \
		org_id=$$(printf '%s' "$$response" | jq -r '.accountId // empty'); \
		if [ -z "$$org_id" ]; then echo "Bootstrap failed. Vercel API response: $$response" >&2; exit 1; fi; \
		mkdir -p .vercel; \
		jq -n --arg org "$$org_id" --arg proj "$${VERCEL_PROJECT_ID}" '{orgId: $$org, projectId: $$proj}' > .vercel/project.json; \
		echo "Wrote .vercel/project.json"

vercel-auth: ## Check that the Vercel CLI is logged in to the linked team
	$(call vercel_auth)

vercel-link-preview: ## Pull preview env vars from Vercel
	$(call vercel_link,preview)

vercel-link-production: ## Pull production env vars from Vercel
	$(call vercel_link,production)

# create-preview-db prints the deployment's database variables as KEY=VALUE
# lines (DATABASE_URL for url; DB_PROVIDER and CLOUD_SQL_DATABASE for
# cloud-sql), each passed as one `-e`. `set -f`: a URL's `?` is a glob.
deploy-client-to-vercel-preview: vercel-link-preview ## Build + deploy a unique preview URL (DB_PROVIDER=url|cloud-sql)
	$(check_provider)
	$(VERCEL_IDS) && \
		set -a && . ./.vercel/.env.preview.local && set +a && \
		db_env=$$($(DB_SCRIPTS)/create-preview-db --branch "$(GIT_BRANCH)") && \
		set -f && set -- && for kv in $$db_env; do set -- "$$@" -e "$$kv"; done && set +f && \
		npx $(VERCEL_CLI) build $(VERCEL_TOKEN_ARG) && \
		npx $(VERCEL_CLI) deploy --prebuilt --archive=tgz \
		"$$@" $(VERCEL_TOKEN_ARG)

# Builds locally because a Vercel build with no cache exceeds the build time limit.
deploy-client-to-vercel-production: vercel-link-production ## Build locally + deploy to PRODUCTION
	@printf 'Deploy %s @ %s%s to PRODUCTION.\n' \
		"$$(git rev-parse --abbrev-ref HEAD)" "$$(git rev-parse --short HEAD)" \
		"$$(git status --porcelain | grep -q . && echo ' (uncommitted changes included)')"; \
		printf 'Type yes to continue: '; \
		read -r reply || { echo "aborted: no answer on stdin" >&2; exit 1; }; \
		[ "$$reply" = yes ] || { echo "aborted" >&2; exit 1; }
	$(VERCEL_IDS) && \
		set -a && . ./.vercel/.env.production.local && set +a && \
		npx $(VERCEL_CLI) build --prod $(VERCEL_TOKEN_ARG) && \
		npx $(VERCEL_CLI) deploy --prebuilt --prod --archive=tgz $(VERCEL_TOKEN_ARG)

# Rebuilds the bundle and functions from the working tree but skips
# installCommand, which is vercel-install.sh: restoring or building the wasm
# packages and default crates, then yarn install. That is only safe when a
# full build has already left the real wasm packages and node_modules on disk,
# so both are checked first: a stub package here would ship `solana`/`anchor`
# commands that throw to production.
#
# The no-op install goes through a derived copy of vercel.json passed as
# --local-config, so the committed one is never edited. `env pull`, not `pull`:
# it refreshes the production variables the build inlines (REACT_APP_*) without
# touching the cached settings, and rootDirectory is re-pinned anyway in case a
# plain `pull` ran since. Server-side variables need none of this -- the
# deployment picks those up from the project when it is created.
FAST_BUILD_CONFIG := .vercel/vercel.noinstall.json
WASM_BUILT_PACKAGES := anchor-cli rust-analyzer seahorse-compile solana-cli spl-token-cli sugar-cli

deploy-client-to-vercel-prod-fast: ## Rebuild without the wasm/install step and deploy to PRODUCTION (needs a prior full build)
	@test -f .vercel/project.json || { echo "no .vercel/project.json — run 'make vercel-bootstrap'" >&2; exit 1; }
	@test -d $(CLIENT_DIR)/node_modules || { echo "no $(CLIENT_DIR)/node_modules — run a full build first" >&2; exit 1; }
	@for pkg in $(WASM_BUILT_PACKAGES); do \
		manifest=wasm/$$pkg/pkg/package.json; \
		test -f "$$manifest" || { echo "wasm/$$pkg/pkg is missing — run a full build first" >&2; exit 1; }; \
		if grep -q '0.0.0-stub' "$$manifest"; then echo "wasm/$$pkg/pkg is a stub — production needs ./wasm/build.sh" >&2; exit 1; fi; \
	done
	@jq '.installCommand = "true"' $(CLIENT_DIR)/vercel.json > $(FAST_BUILD_CONFIG)
	@jq --arg dir '$(CLIENT_DIR)' '.settings.rootDirectory = $$dir' \
		.vercel/project.json > .vercel/project.json.next
	@mv .vercel/project.json.next .vercel/project.json
	export VERCEL_ORG_ID=$$(jq -r .orgId .vercel/project.json) && \
		export VERCEL_PROJECT_ID=$$(jq -r .projectId .vercel/project.json) && \
		npx $(VERCEL_CLI) env pull .vercel/.env.production.local --environment=production --yes $(VERCEL_TOKEN_ARG) && \
		npx $(VERCEL_CLI) build --prod --local-config $(FAST_BUILD_CONFIG) $(VERCEL_TOKEN_ARG) && \
		npx $(VERCEL_CLI) deploy --prebuilt --prod --archive=tgz $(VERCEL_TOKEN_ARG)

# Reads the Production environment's DATABASE_URL_UNPOOLED -- the database
# production actually uses -- and never the preview pull. The preview pull is
# resolved for the checked-out git branch, so on a branch with branch-scoped
# Preview variables it names that branch's Neon database: run from `master-2.0`
# it once reported "nothing to apply" off `preview/master-2.0` while `main` had
# no schema at all.
migrate-production-db: ## Apply pending migrations to the production database (SERVES PRODUCTION)
	@command -v dbmate >/dev/null 2>&1 || { echo "dbmate required — see $(CLIENT_DIR)/db/README.md" >&2; exit 1; }
	@test -f .vercel/project.json || { echo "no .vercel/project.json — run 'make vercel-bootstrap'" >&2; exit 1; }
	@# `env pull`, not `pull`: it writes only the named file and leaves the cached
	@# project settings (and the pinned Root Directory) alone.
	export VERCEL_ORG_ID=$$(jq -r .orgId .vercel/project.json) && \
		export VERCEL_PROJECT_ID=$$(jq -r .projectId .vercel/project.json) && \
		npx $(VERCEL_CLI) env pull .vercel/.env.production.local --environment=production --yes $(VERCEL_TOKEN_ARG)
	@# DATABASE_URL is the PgBouncer endpoint and carries `channel_binding`, which
	@# dbmate's driver cannot parse. The unpooled URL is direct and still carries
	@# the `sslmode` that both dbmate and src/features/persistence/model/db.mjs
	@# require. An inline DATABASE_URL wins over client-v2/.env, so the local
	@# database is never the one that gets migrated here.
	@#
	@# The host is printed before anything else, pending or not: "nothing to
	@# apply" is only reassuring if it says which database had nothing pending.
	@url=$$(grep -m1 '^DATABASE_URL_UNPOOLED=' .vercel/.env.production.local 2>/dev/null | cut -d= -f2- | tr -d '"'); \
		[ -n "$$url" ] || { echo "no DATABASE_URL_UNPOOLED in the Production environment" >&2; exit 1; }; \
		host=$$(printf '%s\n' "$$url" | sed -E 's#^[^@]*@([^/?]*).*#\1#'); \
		printf 'production database: %s\n' "$$host"; \
		cd $(CLIENT_DIR) || exit 1; \
		status=$$(DATABASE_URL="$$url" dbmate status) || exit 1; \
		printf '%s\n' "$$status"; \
		case "$$status" in *"Pending: 0"*) echo "nothing to apply"; exit 0;; esac; \
		printf 'Apply the migrations marked [ ] above to %s\n' "$$host"; \
		printf 'That is the PRODUCTION database. Type yes to continue:'; \
		read -r reply || { echo "aborted: no answer on stdin" >&2; exit 1; }; \
		[ "$$reply" = yes ] || { echo "aborted" >&2; exit 1; }; \
		DATABASE_URL="$$url" dbmate --no-dump-schema up

preview-db-branch: ## Create (or reuse) this git branch's preview database (DB_PROVIDER=url|cloud-sql)
	$(check_provider)
	@$(PREVIEW_CLOUD_SQL) $(DB_SCRIPTS)/create-preview-db --branch "$(GIT_BRANCH)" >/dev/null

# No confirmation here, unlike migrate-production-db: this database belongs to
# one git branch and nothing else reads it, so a wrong migration costs a drop
# and not an incident. Created first if missing, as the Neon branch always was.
migrate-preview-db: ## Apply pending migrations to this git branch's own preview database (DB_PROVIDER=url|cloud-sql)
	$(check_provider)
	@command -v dbmate >/dev/null 2>&1 || { echo "dbmate required — see $(CLIENT_DIR)/db/README.md" >&2; exit 1; }
	@$(PREVIEW_CLOUD_SQL) $(DB_SCRIPTS)/create-preview-db --branch "$(GIT_BRANCH)" >/dev/null
	@cd $(CLIENT_DIR) && $(PREVIEW_CLOUD_SQL) scripts/db/$(DB_PROVIDER)/migration-url --branch "$(GIT_BRANCH)" -- \
		sh -c 'dbmate status; dbmate --no-dump-schema up'
