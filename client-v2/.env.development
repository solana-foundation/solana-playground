# Development only: CRA reads this file for `yarn dev` and `yarn start`, never
# for a production or preview build, where both stay unset and the built-in
# wallet keeps its keys in the page (the `local` signer provider).
#
# `loopback` puts the wallet's key page on the other loopback host of the same
# port: an app on http://localhost:<port> keeps its keys on
# http://127.0.0.1:<port>, and the reverse. Open the app on one of the two.
REACT_APP_WALLET_KEY_ORIGIN=loopback
REACT_APP_WALLET_APP_ORIGIN=loopback
