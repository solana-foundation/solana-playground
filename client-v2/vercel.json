{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "bash scripts/vercel-build.sh",
  "devCommand": "yarn dev-cra",
  "outputDirectory": "build",
  "trailingSlash": false,
  "functions": {
    "api/agent.mjs": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/runtime.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts; frame-ancestors 'self'"
        },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    },
    {
      "source": "/wallet-keys.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'self' https://*.vercel.app http://localhost:* http://127.0.0.1:* https://playground.solana.com"
        },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!wallet-keys\\.html|static/js/wallet-keys).*)",
      "has": [{ "type": "host", "value": "^wallet-keys\\..*$" }],
      "destination": "/wallet-keys.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:authPath+",
      "destination": "/api/auth"
    },
    {
      "source": "/api/ai/status",
      "destination": "/api/ai"
    },
    {
      "source": "/((?!api/|static/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
