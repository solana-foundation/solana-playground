{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "bash scripts/vercel-build.sh",
  "devCommand": "yarn dev-cra",
  "outputDirectory": "build",
  "trailingSlash": false,
  "functions": {
    "api/agent.mjs": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/runtime.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:authPath+",
      "destination": "/api/auth"
    },
    {
      "source": "/api/ai/status",
      "destination": "/api/ai"
    },
    {
      "source": "/((?!api/|static/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
