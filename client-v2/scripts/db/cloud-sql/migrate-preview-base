#!/usr/bin/env bash
# Bring the template `solpg_preview_base` up to client-v2/db/migrations, so a
# new preview's clone starts current. preview-shared-db.yml runs it on every
# push to master that adds a migration; run it by hand after a failed run. A
# clone works without it, replaying what the base lacks.
#
# The base refuses connections outside this script, because cloning fails
# while any session is connected to a template. This lifts that for the run
# and restores it on every exit, failure included.
#
#   migrate-preview-base
set -euo pipefail
. "$(dirname "$0")/../lib.sh"

[ "$#" -eq 0 ] || { echo "usage: $(basename "$0")" >&2; exit 2; }
command -v dbmate >/dev/null 2>&1 || { echo "dbmate required: see client-v2/db/README.md" >&2; exit 1; }
. "$DB_SCRIPTS/cloud-sql/proxy.sh"

start_proxy
close_base() {
  admin_sql "alter database $PREVIEW_BASE with allow_connections false" ||
    echo "WARNING: $PREVIEW_BASE still accepts connections; previews cannot clone it until: alter database $PREVIEW_BASE with allow_connections false" >&2
  stop_proxy
}
trap close_base EXIT

url=$(proxy_url "$PREVIEW_BASE" "$CLOUD_SQL_USER")
admin_sql "alter database $PREVIEW_BASE with allow_connections true"
cd "$CLIENT_V2"
DATABASE_URL=$url dbmate --no-dump-schema up
