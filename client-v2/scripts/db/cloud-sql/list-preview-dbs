#!/usr/bin/env bash
# List the PR databases on the preview instance, for preview-sweep.yml: one
# line per database, `<pr number> <age in minutes>`, the age `-` when the
# database carries no creation stamp from create-preview-db.
#
# Only names matching PREVIEW_PR_DB_PATTERN are listed, so the shared
# database, the template and laptop databases never reach the sweep.
#
#   list-preview-dbs
set -euo pipefail
. "$(dirname "$0")/../lib.sh"

[ "$#" -eq 0 ] || { echo "usage: $(basename "$0")" >&2; exit 2; }
. "$DB_SCRIPTS/cloud-sql/proxy.sh"

start_proxy
trap stop_proxy EXIT

rows=$(admin_sql "select datname, coalesce(substring(shobj_description(oid, 'pg_database') from '^created-at:([0-9]+)\$'), '') from pg_database where datname ~ '$PREVIEW_PR_DB_PATTERN' order by datname")

now=$(date +%s)
while IFS='|' read -r name created; do
  [ -n "$name" ] || continue
  # The query filtered already; this keeps a pattern drift from widening it
  [[ "$name" =~ $PREVIEW_PR_DB_PATTERN ]] || continue
  if [[ "$created" =~ ^[0-9]+$ ]]; then
    age=$(((now - created) / 60))
  else
    age=-
  fi
  printf '%s %s\n' "${name##*_}" "$age"
done <<<"$rows"
