#!/usr/bin/env bash
# The URL dbmate migrates through: the proxy on 127.0.0.1, logged in as the
# caller's IAM database user, with the session role set to CLOUD_SQL_USER so
# every table a migration creates is owned by the application's user.
#
# A preview's database comes from preview-name.mjs. `production` migrates
# CLOUD_SQL_DATABASE, which `make migrate-production-db` reads from Vercel's
# Production environment, as an operator: no CI identity holds a role on the
# production instance. `shared` migrates the preview instance's shared
# database; by convention only preview-shared-db.yml passes it, on push to
# master, enforced by review of workflow changes.
#
#   migration-url (--pr <number> | --branch <name> | production | shared) [-- <command>...]
#
# With a command, runs it with DATABASE_URL set and stops the proxy after.
# Without, prints the URL and leaves the proxy running, naming its pid.
set -euo pipefail
. "$(dirname "$0")/../lib.sh"

split_command "$@"
parse_target "production|shared" ${TARGET_ARGS[@]+"${TARGET_ARGS[@]}"}

. "$DB_SCRIPTS/cloud-sql/proxy.sh"
case "$TARGET_KIND" in
  production) name=${CLOUD_SQL_DATABASE:?CLOUD_SQL_DATABASE is unset: no Production database to migrate} ;;
  shared) name=$SHARED_PREVIEW_DB ;;
  *) name=$(preview_db_name) ;;
esac

start_proxy
trap stop_proxy EXIT
url=$(proxy_url "$name" "$CLOUD_SQL_USER")

if [ "${#COMMAND[@]}" -eq 0 ]; then
  trap - EXIT
  echo "cloud-sql-proxy left running as pid $PROXY_PID; stop it with: kill $PROXY_PID" >&2
  printf '%s\n' "$url"
else
  DATABASE_URL=$url "${COMMAND[@]}"
fi
